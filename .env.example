# Copy this file, name the copy ".env" and fill in what you need.
# Tailor works without any of this, but AI rewriting needs the key.

# FREE: turns on AI reading and rewriting with Google Gemini.
# Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=

# Leave blank to let Tailor pick a current Gemini model.
TAILOR_GEMINI_MODEL=

# The port the app runs on.
PORT=5080
